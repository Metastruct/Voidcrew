// Bubberstation per-limb body markings, ported to Voidcrew.
//
// Generated by .pi/modular_bubber/tools/port_bubber_body_markings.py -- do not edit by hand.
// The `/datum/body_marking` datums are Bubber's as-authored; only the icon paths and
// a few species ids differ. `port_make_body_marking_references()` flattens these into
// the GLOB.body_markings / GLOB.body_markings_per_limb / GLOB.body_marking_sets lists.
//
// PORTED FROM: modular_skyrat + modular_zubbers body_markings/*.dm

/// The icon a body marking is drawn from.
/datum/body_marking
	/// The icon file the body marking is located in.
	var/icon
	/// The icon_state of the body marking.
	var/icon_state
	/// The preview name of the body marking. HAS to be unique.
	var/name
	/// The colour the marking defaults to. Either a hex colour ("#FFFFFF") or one of
	/// the DEFAULT_* sentinels below.
	var/default_color
	/// Which bodyparts the marking affects, in bitflags (HEAD | CHEST | ...).
	var/affected_bodyparts
	/// Which species this marking is recommended to. Only used to filter the menu.
	var/recommended_species = list(SPECIES_MAMMAL)
	/// When set, the colour picker is always shown regardless of the pref settings.
	var/always_color_customizable
	/// Whether the body marking sprite is the same for both sexes. Only relevant for
	/// the chest right now.
	var/gendered = TRUE

/datum/body_marking/New()
	if(!default_color)
		default_color = "#FFFFFF"

/// Resolve this marking's default colour from the given dna.features.
/datum/body_marking/proc/get_default_color(list/features, datum/species/pref_species)
	var/list/colors
	switch(default_color)
		if(DEFAULT_PRIMARY)
			colors = sanitize_hexcolor(features[FEATURE_MUTANT_COLOR])
		if(DEFAULT_SECONDARY)
			colors = sanitize_hexcolor(features[FEATURE_MUTANT_COLOR_TWO])
		if(DEFAULT_TERTIARY)
			colors = sanitize_hexcolor(features[FEATURE_MUTANT_COLOR_THREE])
		if(DEFAULT_SKIN_OR_PRIMARY)
			colors = sanitize_hexcolor(features[FEATURE_MUTANT_COLOR])
		else
			colors = default_color
	return colors

/// A whole set of markings, applied together as a preset.
/datum/body_marking_set
	/// The preview name of the body marking set. HAS to be unique.
	var/name
	/// List of the body marking names in this set.
	var/body_marking_list
	/// Which species this marking set is recommended to. Only used to filter the menu.
	var/recommended_species = list(SPECIES_MAMMAL, SPECIES_TAJARAN, SPECIES_VULPKANIN, SPECIES_TESHARI)

/datum/body_marking_set/none
	name = SPRITE_ACCESSORY_NONE
	recommended_species = null
	body_marking_list = list()


